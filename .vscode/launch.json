    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: 启动整个项目",
            "type": "debugpy",
            "request": "launch",
            // 启动入口改为 main.py（web_server.py 不再有 __main__）
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            // 重点：cwd 必须是 server/，确保 net/game/proto 包能被正确识别
            "cwd": "${workspaceFolder}",
            "args": ["--console"]
        }
    ]
}